# Copy to .env.local and fill in. .env.local is git-ignored — never commit real keys.
# On Vercel, set the same variables under Project Settings → Environment Variables.

# --- Supabase (browser-safe: shipped to the client) ---
# app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets (NEVER prefix NEXT_PUBLIC_; never sent to the browser) ---
# Service-role key bypasses RLS — used only for trusted server-side reads
# (e.g. the agent's get_portfolio with a server-derived user_id).
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com (powers the AI SDK agent route)
ANTHROPIC_API_KEY=

# Polygon.io — polygon.io (quotes, history, options chains, fundamentals, news)
POLYGON_API_KEY=
