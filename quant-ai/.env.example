# Copy to .env and fill in your keys.  Never commit .env.

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=

# Google AI Studio — aistudio.google.com/app/apikey (placeholder, phase 2)
GOOGLE_API_KEY=

# Finnhub — finnhub.io (free tier, 60 req/min)
FINNHUB_API_KEY=

# Polygon.io — polygon.io (optional upgrade, ~$29/mo Starter)
# Leave blank to use yfinance fallback
POLYGON_API_KEY=
