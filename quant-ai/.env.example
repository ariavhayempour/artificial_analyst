# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=

# Finnhub — finnhub.io (free tier, 60 req/min)
FINNHUB_API_KEY=

# Supabase — app.supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: ADMIN ONLY (e.g. seeding the allowlist). Never expose to a
# browser/client. Leave blank unless running admin scripts server-side.
SUPABASE_SERVICE_ROLE_KEY=

# --- placeholders, not yet used ---
# Google AI Studio — aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# Polygon.io — polygon.io (optional upgrade; leave blank to use yfinance)
POLYGON_API_KEY=
